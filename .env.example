# 复制本文件为项目根目录 .env 后按需修改（.env 不要提交到 git）

# Token HMAC 密钥（至少 32 字符，可用：python -c "import secrets; print(secrets.token_urlsafe(48))"）
TOKEN_SECRET=请替换为至少32字符的随机长串

# 允许跨域的前端来源（逗号分隔，禁止 *）
# 本地默认即可；上线后改成你的公网域名，例如 https://your-app.example.com
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# 演示账号密码（启动时写入/更新 admin、student；至少 8 位）
DEMO_ADMIN_PASSWORD=请设置管理员强密码
DEMO_STUDENT_PASSWORD=请设置学生强密码
